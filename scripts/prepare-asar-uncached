#!/usr/bin/env bash
set -euo pipefail

: "${ASAR_SCRATCH:?}"
ASAR_OUTPUT_DIR="$ASAR_SCRATCH/asar"

build_cores="${NIX_BUILD_CORES:-0}"
if ((build_cores <= 0)); then
  build_cores="$(node -p 'require("node:os").availableParallelism()')"
fi

extract_zip() {
  local archive="$1" destination="$2"
  shift 2

  if command -v ripunzip >/dev/null 2>&1; then
    RAYON_NUM_THREADS="$build_cores" ripunzip unzip-file -d "$destination" "$archive" "$@"
  else
    unzip -oq "$archive" "$@" -d "$destination"
  fi
}

extract_zip "$HOSTED_CODEX_APP_ZIP" "$ASAR_SCRATCH/" \
  'ChatGPT.app/Contents/Resources/app.asar' \
  'ChatGPT.app/Contents/Resources/app.asar.unpacked/*'
asar extract "${ASAR_SCRATCH}/ChatGPT.app/Contents/Resources/app.asar" "${ASAR_OUTPUT_DIR}"
cp assets/* "${ASAR_OUTPUT_DIR}/webview/"
PWA_SOURCE_ICON="${ASAR_OUTPUT_DIR}/webview/assets/app-f483cb0295ed.png"
PWA_TARGET_ICON="${ASAR_OUTPUT_DIR}/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
if [[ -n "${DEV:-}" ]]; then
  prettier --log-level warn --ignore-path /dev/null --ignore-unknown --write "${ASAR_OUTPUT_DIR}"
else
  patched_files=()
  while IFS= read -r patched_file; do
    patched_files+=("$patched_file")
  done < <(
    awk -v output="$ASAR_OUTPUT_DIR" '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, output "/"); print}' patches/*.patch | sort -u
  )
  printf '%s\0' "${patched_files[@]}" | xargs -0 -n 1 -P "$build_cores" \
    prettier --log-level warn --ignore-path /dev/null --ignore-unknown --write
fi
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-remove-csp.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-style.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-preload.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-favicon.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-pwa.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-thread-title.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-initial-route.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-electron-shim-close-sidebar.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-prosemirror-inputmode.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-use-atfs-for-local-files.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-statsig-override-adapter.patch
# Use the existing Statsig fallback after one failed bootstrap request instead
# of keeping the browser on the startup screen through six timeout attempts.
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-statsig-bootstrap-retry.patch
# Allow up to 60 seconds for the authenticated post-login Statsig bootstrap.
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-statsig-bootstrap-timeout.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-prompt-search-param.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/sentry-disable-shell.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/sentry-disable-webview.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/preload-disable-device-check.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/webview-safe-header-left.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/app-host-json-rpc.patch
patch --silent --batch --forward --strip 1 --directory "${ASAR_OUTPUT_DIR}" < patches/app-host-browser-windows.patch
rm -rf "${ASAR_OUTPUT_DIR}/node_modules/better-sqlite3"
